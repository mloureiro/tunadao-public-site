---
/**
 * TunaCardSimple - Compact tuna card with crest (logo), sigla, and city.
 */
import type { FrontendTunaWithLogo } from '@lib/cms/types';

interface Props {
  tuna: FrontendTunaWithLogo;
  showCity?: boolean;
}

const { tuna, showCity = true } = Astro.props;
const initials = tuna.shortName.slice(0, 2).toUpperCase();
const displayName = tuna.shortName || tuna.fullName;
---

<div class="tuna-card">
  <div class="tuna-crest">
    {
      tuna.logoUrl ? (
        <img src={tuna.logoUrl} alt={displayName} class="tuna-logo" loading="lazy" />
      ) : (
        <span class="tuna-initials" aria-hidden="true">
          {initials}
        </span>
      )
    }
  </div>
  <div class="tuna-info">
    <p class="tuna-name">{displayName}</p>
    {showCity && tuna.city && <p class="tuna-city">{tuna.city}</p>}
  </div>
</div>

<style>
  .tuna-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .tuna-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  [data-theme='dark'] .tuna-card:hover {
    border-color: var(--color-primary-light);
  }

  .tuna-crest {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tuna-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .tuna-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: var(--radius-sm);
    color: var(--color-text-inverted);
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }

  .tuna-info {
    flex: 1;
    min-width: 0;
  }

  .tuna-name {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tuna-city {
    margin: var(--space-1) 0 0 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
